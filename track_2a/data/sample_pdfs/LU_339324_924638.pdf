    <script>
        var hidFcSolution = document.getElementById("maincontent_4_hidFcSolution");
        var buttonSubmit;
        var buttonStyle;
        var buttonColor;
        var divHinweis;
        
        document.addEventListener("DOMContentLoaded", function (event) {
            buttonSubmit = document.getElementById("maincontent_4_btnSubmit");
            buttonStyle = getComputedStyle(buttonSubmit);
            buttonColor = buttonStyle['background-color'];
            buttonSubmit.style.backgroundColor = "#dddddd";
            buttonSubmit.setAttribute('disabled', '');
        });

        function fcCallback(solution) {
            hidFcSolution.value = solution;
            divHinweis = document.getElementById("divHinweis");
            divHinweis.style.visibility = "hidden";
            buttonSubmit = document.getElementById("maincontent_4_btnSubmit");
            buttonSubmit.style.backgroundColor = buttonColor;
            buttonSubmit.removeAttribute('disabled');
        }
    </script>

